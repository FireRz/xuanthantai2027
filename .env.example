# Chép thành .env (dev) — KHÔNG commit file .env.

# Postgres. Dev cục bộ: docker compose up -d  hoặc  npm run db:local
# Trên Vercel, tích hợp Neon tự tạo DATABASE_URL (pooled) và DATABASE_URL_UNPOOLED (direct).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xtt"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/xtt"

# DB riêng cho test integration (bị xóa trắng khi chạy test).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xtt_test"

# Vercel Blob — lấy token của store dev trong Vercel → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=""

# Auth.js — tạo bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""

# Chỉ cho `npm run db:local` (không Docker): thư mục chứa binary + dữ liệu Postgres,
# phải là đường dẫn không dấu. Mặc định ~/.xuan-than-tai
# LOCAL_PG_HOME="D:/xtt-dev"
